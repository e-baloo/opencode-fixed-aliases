{
  "name": "opencode-fixed-aliases",
  "version": "0.9.3",
  "description": "Governed, fixed model aliases for OpenCode agents",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-baloo/opencode-fixed-aliases.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
  "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "model",
        "alias"
    ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29",
    "@opencode/schema": "2.0.29"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "effect": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "author": "e-Baloo"
}
